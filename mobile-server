#!/data/data/com.termux/files/usr/bin/bash

case "${1:-}" in
    start)
        echo "Starting Mobile Server..."
        if pgrep nginx >/dev/null 2>&1; then echo "  Nginx      Already running"; elif nginx -t >/dev/null 2>&1; then nginx && echo "  Nginx      Running" || echo "  Nginx      Failed"; else echo "  Nginx      Config error — run 'nginx -t'"; fi
        if pgrep php-fpm >/dev/null 2>&1; then echo "  PHP-FPM    Already running"; else php-fpm 2>/dev/null && echo "  PHP-FPM    Running" || echo "  PHP-FPM    Failed"; fi
        if pgrep mariadbd >/dev/null 2>&1; then echo "  MariaDB    Already running"; else mariadbd-safe >/dev/null 2>&1 & sleep 2; if pgrep mariadbd >/dev/null 2>&1; then echo "  MariaDB    Running"; else echo "  MariaDB    Failed"; fi; fi
        ;;
    stop)
        echo "Stopping Mobile Server..."
        for svc in nginx php-fpm mariadbd; do
            if pgrep "$svc" >/dev/null 2>&1; then
                pkill -9 "$svc" 2>/dev/null || true
                sleep 1
                if pgrep "$svc" >/dev/null 2>&1; then
                    printf "  %-10s  Force killed\n" "$svc"
                else
                    printf "  %-10s  Stopped\n" "$svc"
                fi
            else
                printf "  %-10s  Not running\n" "$svc"
            fi
        done
        echo "Mobile Server stopped"
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        echo "Mobile Server Status"
        echo "--------------------"
        for svc in nginx php-fpm mariadbd; do
            if pgrep "$svc" >/dev/null 2>&1; then
                printf "  %-10s  Running\n" "$svc"
            else
                printf "  %-10s  Stopped\n" "$svc"
            fi
        done
        ;;
    update)
        HOME_DIR="$HOME"
        TARGET_DIR="$HOME_DIR/server/sites/default/public_html"
        TMP_DIR="$(mktemp -d 2>/dev/null || echo "/tmp/mobile-server-update")"
        REPO_URL="https://github.com/SayfullahSayeb/mobile-server.git"

        echo "Updating Mobile Server from GitHub..."
        echo

        rm -rf "$TMP_DIR" 2>/dev/null
        if git clone --depth 1 "$REPO_URL" "$TMP_DIR" 2>/dev/null; then
            echo "  Cloned repository."

            # Install elfinder files (downloaded separately)
            ELFINDER_VER="2.1.69"
            ELDEST="$TARGET_DIR/elfinder/php"
            rm -rf /tmp/elfinder.zip /tmp/elFinder-$ELFINDER_VER/ 2>/dev/null
            curl -fsSL --retry 3 "https://github.com/Studio-42/elFinder/archive/refs/tags/$ELFINDER_VER.zip" -o /tmp/elfinder.zip 2>/dev/null
            if [ -f /tmp/elfinder.zip ] && unzip -qo /tmp/elfinder.zip -d /tmp/ 2>/dev/null; then
                rm -rf "$ELDEST" 2>/dev/null
                cp -r "/tmp/elFinder-$ELFINDER_VER/php" "$ELDEST" 2>/dev/null
                printf "  \xE2\x9C\x93 Updated elFinder library\n"
            else
                printf "  [!] elFinder library download failed\n"
            fi

            # Copy all files from repo (skip .git)
            for item in "$TMP_DIR"/* "$TMP_DIR"/.[!.]*; do
                base="$(basename "$item")"
                [ "$base" = ".git" ] || [ "$base" = "." ] || [ "$base" = ".." ] && continue
                cp -r "$item" "$TARGET_DIR/" 2>/dev/null
                printf "  \xE2\x9C\x93 Synced %s\n" "$base"
            done

            # Update CLI script
            CLI_DEST="$PREFIX/bin/mobile-server"
            if [ -f "$TMP_DIR/mobile-server" ]; then
                cp "$TMP_DIR/mobile-server" "$CLI_DEST" 2>/dev/null
                chmod +x "$CLI_DEST" 2>/dev/null
                printf "  \xE2\x9C\x93 Updated CLI\n"
            else
                printf "  [!] Failed to update CLI\n"
            fi

            rm -rf "$TMP_DIR" 2>/dev/null
            echo
            echo "Update completed successfully."
        else
            echo "[!] Failed to clone repository. Check internet connection."
            rm -rf "$TMP_DIR" 2>/dev/null
            exit 1
        fi
        ;;
    *)
        echo "Usage: mobile-server {start|stop|restart|status|update}"
        exit 1
        ;;
esac
